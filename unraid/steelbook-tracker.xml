<?xml version="1.0"?>
<Container version="2">
  <Name>steelbook-tracker</Name>
  <Repository>adiuv0/steelbook-tracker:latest</Repository>
  <Registry>https://hub.docker.com/r/adiuv0/steelbook-tracker</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/adiuv0/steelbook-tracker/issues</Support>
  <Project>https://github.com/adiuv0/steelbook-tracker</Project>
  <Overview>Tracks upcoming 4K steelbook announcements and preorders (Blu-ray.com and r/steelbooks), sends alerts to Home Assistant, and lets you tick off what you've bought.</Overview>
  <Category>Tools: MediaApp:Video</Category>
  <WebUI>http://[IP]:[PORT:8787]/</WebUI>
  <Icon>https://raw.githubusercontent.com/adiuv0/steelbook-tracker/main/app/static/icon.png</Icon>
  <Config Name="Web UI port" Target="8787" Default="8787" Mode="tcp" Description="Port for the tracker web page" Type="Port" Display="always" Required="true" Mask="false">8787</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/appdata/steelbook-tracker" Mode="rw" Description="Database location" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/steelbook-tracker</Config>
  <Config Name="Home Assistant webhook URL" Target="HA_WEBHOOK_URL" Default="" Mode="" Description="e.g. http://192.168.1.10:8123/api/webhook/steelbook_tracker_xxxx" Type="Variable" Display="always" Required="false" Mask="true"></Config>
  <Config Name="App URL" Target="APP_URL" Default="" Mode="" Description="Address of this web UI, linked from notifications, e.g. http://192.168.1.20:8787" Type="Variable" Display="always" Required="false" Mask="false"></Config>
  <Config Name="Timezone" Target="TZ" Default="America/Los_Angeles" Mode="" Description="Timezone for the daily digest" Type="Variable" Display="always" Required="false" Mask="false">America/Los_Angeles</Config>
  <Config Name="Daily digest time" Target="DIGEST_TIME" Default="09:00" Mode="" Description="HH:MM, local time" Type="Variable" Display="always" Required="false" Mask="false">09:00</Config>
  <Config Name="Scan every (hours)" Target="POLL_HOURS" Default="4" Mode="" Description="How often to check sources" Type="Variable" Display="advanced" Required="false" Mask="false">4</Config>
  <Config Name="Reddit feed" Target="REDDIT_ENABLED" Default="true" Mode="" Description="Include r/steelbooks drop and preorder posts in the digest" Type="Variable" Display="advanced" Required="false" Mask="false">true</Config>
</Container>
